## Each open file owns its editor, so switching files preserves text, selection,
## scroll position, folding and undo history. Disk conflict checks precede atomic saves.
from ui import Font, TextEditor
from language.highlighter import Highlighter
from language.tm import TmHighlighter
from language.grammars import GrammarSet
from language.appearance import SyntaxTheme
from interop import Connection
import files
import ui

pub class Document:
    pub var path: str
    pub let editor: TextEditor
    var original: str
    var baseline: str
    let crlf: bool
    var highlighting: Connection?
    var highlighter: Highlighter?
    var tm: TmHighlighter?
    ## The name of the active highlighter (for the status bar), and the set + theme kept so the
    ## user can switch highlighter by hand from the status bar's language menu.
    var language: str
    var grammars: GrammarSet? = none
    var syntax: SyntaxTheme? = none

    pub func init(self, path: str, font: Font? = none, syntax: SyntaxTheme? = none, grammars: GrammarSet? = none, blank: bool = false, wrap: bool = false) -> unit!:
        let text = "" if blank else files.read_text(path)
        self.path = "" if blank else files.absolute_path(path)
        self.original = text
        self.crlf = text.contains("\r\n")
        let editor = TextEditor(text, font = font, wrap = wrap)
        self.editor = editor
        self.baseline = editor.text()
        editor.set_baseline(self.baseline)
        self.highlighting = none
        self.highlighter = none
        self.tm = none
        self.language = "Text"
        try self.attach(syntax, grammars)

    ## Connect the highlighter that fits the current path: a grammar from the set when one claims
    ## the extension, otherwise the built-in Luce lexer for `.luc`/`.lucb`, otherwise nothing.
    func attach(self, syntax: SyntaxTheme?, grammars: GrammarSet?) -> unit!:
        if let connection = self.highlighting: connection.disconnect()
        self.highlighting = none
        self.highlighter = none
        self.tm = none
        self.grammars = grammars
        self.syntax = syntax
        self.language = "Text"
        if self.path == "":
            return
        # Luce and Luce Base use the built-in single-pass lexer: it is far faster than running a
        # TextMate grammar and is what the editor opens most, so it stays the default for them.
        if self.path.ends_with(".luc") or self.path.ends_with(".lucb"):
            let service = Highlighter(self.editor, syntax)
            service.update()
            self.highlighting = self.editor.on_change(service.update)
            self.highlighter = service
            self.language = "Luce Base" if self.path.ends_with(".lucb") else "Luce"
            return
        self.language = language_from_path(self.path)
        if let registry = grammars:
            if let grammar = registry.grammar_for(self.path):
                let service = try TmHighlighter(self.editor, grammar, syntax)
                service.update()
                self.highlighting = self.editor.on_change(service.update)
                self.tm = service
                let named = grammar.name()
                if named != "":
                    self.language = named

    ## The language label for the status bar.
    pub func language_label(self) -> str:
        return self.language

    ## Switch the highlighter to the grammar in `filename` (from the status-bar language menu).
    pub func set_language(self, filename: str) -> unit!:
        let registry = self.grammars else return
        let grammar = registry.grammar_named(filename) else return
        if let connection = self.highlighting: connection.disconnect()
        self.highlighting = none
        self.highlighter = none
        self.tm = none
        let service = try TmHighlighter(self.editor, grammar, self.syntax)
        service.update()
        self.highlighting = self.editor.on_change(service.update)
        self.tm = service
        let named = grammar.name()
        self.language = named if named != "" else filename

    pub func set_syntax(self, theme: SyntaxTheme) -> unit!:
        if let highlighter = self.highlighter:
            highlighter.set_theme(theme)
        if let tm = self.tm:
            tm.set_theme(theme)

    pub func rename(self, path: str, syntax: SyntaxTheme?, grammars: GrammarSet?) -> unit!:
        self.path = path
        try self.attach(syntax, grammars)
        if self.highlighter == none and self.tm == none:
            self.editor.set_highlights([])
            discard(self.editor.set_folds([], self.editor.version()))

    ## An untitled buffer has no path on disk yet; saving it needs a destination.
    pub func is_untitled(self) -> bool:
        return self.path == ""

    ## Write an untitled buffer to a new file, then adopt it: refuse an existing
    ## path, keep the edits, and enable language features for a source extension.
    pub func save_as(self, path: str, syntax: SyntaxTheme?, grammars: GrammarSet?) -> unit!:
        let text = self.encoded_text()
        files.create_text(path, text)
        self.original = text
        self.baseline = self.editor.text()
        self.editor.set_baseline(self.baseline)
        self.rename(path, syntax, grammars)

    pub func dirty(self) -> bool!:
        return self.editor.text() != self.baseline

    func encoded_text(self) -> str!:
        let text = self.editor.text()
        return text.replace("\n", "\r\n") if self.crlf else text

    pub func save(self) -> unit!:
        let text = self.encoded_text()
        if not self.dirty():
            return
        if files.read_text(self.path) != self.original:
            error(ui.invalid, "The file changed on disk. Your edits are still open; save a copy before reloading.")
        files.write_text(self.path, text)
        self.original = text
        self.baseline = self.editor.text()
        self.editor.set_baseline(self.baseline)

## A fallback language label from a path's extension, for files no grammar claims.
func language_from_path(path: str) -> str:
    let base = path.replace("\\", "/").split("/").last else path
    let parts = base.split(".")
    if parts.length < 2:
        return "Text"
    let ext = parts.last else ""
    return ext if ext != "" else "Text"
