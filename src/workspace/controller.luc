## Application coordination stays in Luce. Native controls expose user intent;
## this controller handles workspace navigation, dirty files and command status.
from ui import Application, Font, Text, TextEditor, ListView, VStack, PaneHeader, IconKind
from interop import Connection
from workspace.document import Document
from workspace.explorer import Explorer
from commands.runner import Runner
from language.appearance import SyntaxTheme
from workspace.explorer import Entry
import workspace.operations as operations
import workspace.paths as paths
import ui
import files
import editor.file_items as file_items

pub class Workspace:
    let app: Application
    let explorer: Explorer
    let listing: ListView
    let directory_header: PaneHeader
    let title: PaneHeader
    let status: Text
    let editor_host: VStack
    let font: Font?
    let runner: Runner
    var documents: list[Document]
    var connections: list[Connection]
    var active: Document? = none
    var syntax: SyntaxTheme? = none
    var status_text: str = ""
    var message_time: float = 0.0
    var close_pending: bool = false
    var discard_confirmed: bool = false

    pub func init(self, app: Application, explorer: Explorer, listing: ListView, directory_header: PaneHeader,
                  title: PaneHeader, status: Text, editor_host: VStack, runner: Runner, font: Font? = none):
        self.documents = []
        self.connections = []
        self.app = app
        self.explorer = explorer
        self.listing = listing
        self.directory_header = directory_header
        self.title = title
        self.status = status
        self.editor_host = editor_host
        self.runner = runner
        self.font = font

    pub func has_document(self) -> bool:
        return self.active != none

    pub func current_editor(self) -> TextEditor?:
        let active = self.active else return none
        return active.editor

    pub func set_syntax(self, theme: SyntaxTheme) -> unit!:
        self.syntax = theme
        for document in self.documents:
            document.set_syntax(theme)

    pub func focus_editor(self) -> unit!:
        if let document = self.active:
            self.app.focus(document.editor.layout())
        elif self.editor_host.layout().child_count() > 0:
            self.app.focus(self.editor_host.layout().child(0).layout())

    pub func selected_entry(self) -> Entry?:
        let index = self.listing.selected_index()
        if index < 0 or index >= self.explorer.entries.length:
            return none
        let entry = self.explorer.entries[index]
        return none if entry.name == ".." else entry

    pub func directory(self) -> str:
        return self.explorer.directory

    pub func refresh_files(self) -> unit!:
        self.explorer.open(self.explorer.directory)
        self.listing.set_items(file_items.present(self.explorer.entries))

    pub func create_file(self, directory: str, name: str) -> unit!:
        let path = operations.create_file(directory, name)
        self.refresh_files()
        self.open(path)

    pub func create_folder(self, directory: str, name: str) -> unit!:
        operations.create_folder(directory, name)
        self.refresh_files()

    pub func duplicate_file(self, path: str) -> unit!:
        let copied = operations.duplicate(path)
        self.refresh_files()
        self.report("Created " + paths.name(copied))

    pub func rename_entry(self, source: str, name: str) -> unit!:
        let entry = paths.join(files.absolute_path(paths.parent(source)), paths.name(source))
        let linked = files.path_kind(entry, follow_symlinks = false) == files.FileKind.symlink
        let identity = files.absolute_path(entry)
        let destination = operations.child(paths.parent(entry), name)
        if entry == destination:
            return
        files.move_path(entry, destination)
        let renamed = files.absolute_path(destination)
        for document in self.documents:
            if not linked and (document.path == identity or document.path.starts_with(identity + "/")):
                document.rename(renamed + document.path[identity.length..], self.syntax)
        self.refresh_files()
        self.changed()

    pub func delete_entry(self, path: str) -> unit!:
        let entry = paths.join(files.absolute_path(paths.parent(path)), paths.name(path))
        let linked = files.path_kind(entry, follow_symlinks = false) == files.FileKind.symlink
        let identity = files.absolute_path(entry)
        for document in self.documents:
            if not linked and (document.path == identity or document.path.starts_with(identity + "/")) and document.dirty():
                error(ui.invalid, "Save unsaved changes before deleting " + paths.name(path))
        files.delete_path(entry, recursive = true)
        var index = self.documents.length
        while index > 0:
            index -= 1
            let document = self.documents[index]
            if not linked and (document.path == identity or document.path.starts_with(identity + "/")):
                if let active = self.active:
                    if active is document:
                        self.active = none
                self.connections[index].disconnect()
                discard(self.connections.remove_at(index))
                discard(self.documents.remove_at(index))
        if self.active == none:
            if let remaining = self.documents.first:
                self.open(remaining.path)
            else:
                self.editor_host.set_children([TextEditor("Open a file from the explorer", read_only = true, line_numbers = false, font = self.font)])
                self.title.set_text("EDITOR")
                self.title.set_detail("")
                self.title.set_icon(IconKind.code)
        self.refresh_files()

    pub func activate(self, index: int) -> unit!:
        self.open_entry(index) catch failure:
            self.report(failure.message)

    func open_entry(self, index: int) -> unit!:
        if index < 0 or index >= self.explorer.entries.length:
            return
        let entry = self.explorer.entries[index]
        if entry.directory:
            self.explorer.open(entry.path)
            self.listing.set_items(file_items.present(self.explorer.entries))
            self.directory_header.set_detail(paths.name(self.explorer.directory))
        else:
            self.open(entry.path)

    pub func open(self, path: str) -> unit!:
        let identity = files.absolute_path(path)
        var chosen: Document? = none
        for document in self.documents:
            if document.path == identity:
                chosen = document
                break
        if chosen == none:
            if self.documents.length >= 32:
                error(ui.invalid, "This workspace already has 32 open files. Save and reopen the editor to start another session.")
            let document = Document(identity, self.font, self.syntax)
            self.documents.append(document)
            self.connections.append(document.editor.on_change(self.changed))
            chosen = document
        let document = chosen else return
        self.active = document
        self.editor_host.set_children([document.editor])
        self.changed()
        self.app.focus(document.editor.layout())
        self.close_pending = false

    pub func changed(self) -> unit!:
        if let document = self.active:
            self.title.set_text(paths.name(document.path) + (" *" if document.dirty() else ""))
            self.title.set_detail(paths.parent(document.path))
            self.title.set_icon(file_items.icon(document.path))

    pub func report(self, message: str) -> unit!:
        self.status.set_text(paths.short(message, 108))
        self.status_text = message
        self.message_time = 5.0

    pub func command(self, name: str) -> unit!:
        self.perform(name) catch failure:
            self.report(failure.message)

    func perform(self, name: str) -> unit!:
        if name == "stop":
            self.runner.stop()
            return
        if name == "discard":
            if self.close_pending:
                self.discard_confirmed = true
                self.app.stop()
            else:
                self.report("Close the window first to review unsaved files before discarding.")
            return
        if name == "save_all":
            for document in self.documents:
                document.save()
            self.changed()
            self.report("All open files saved")
            return
        let document = self.active else return
        if name == "fold":
            discard(document.editor.toggle_fold(document.editor.line()))
        elif name == "fold_all":
            document.editor.fold_all()
        elif name == "unfold_all":
            document.editor.unfold_all()
        elif name == "save":
            document.save()
            self.changed()
            self.report("Saved " + paths.name(document.path))
        elif name == "build" or name == "run":
            for open_document in self.documents:
                open_document.save()
            if not document.path.ends_with(".luc") and not document.path.ends_with(".lucb"):
                error(ui.invalid, "Select a Luce or Luce Base source file to build.")
            self.runner.build(document.path, name == "run")
            self.changed()

    pub func save(self) -> unit!:
        self.command("save")

    pub func save_all(self) -> unit!:
        self.command("save_all")

    pub func build(self) -> unit!:
        self.command("build")

    pub func run(self) -> unit!:
        self.command("run")

    pub func stop(self) -> unit!:
        self.command("stop")

    pub func discard_and_close(self) -> unit!:
        self.command("discard")

    pub func toggle_fold(self) -> unit!:
        self.command("fold")

    pub func fold_all(self) -> unit!:
        self.command("fold_all")

    pub func unfold_all(self) -> unit!:
        self.command("unfold_all")

    pub func can_close(self) -> bool!:
        if self.discard_confirmed:
            return true
        var count = 0
        for document in self.documents:
            if document.dirty():
                count += 1
        if count == 0:
            return true
        self.close_pending = true
        self.report(f"{count} unsaved files. Choose Save all, or Discard & close, then close the window.")
        return false

    pub func frame(self, elapsed: float) -> unit!:
        self.tick(elapsed) catch failure:
            self.report(failure.message)

    func tick(self, elapsed: float) -> unit!:
        self.runner.poll()
        self.message_time -= elapsed
        if self.close_pending or self.message_time > 0.0:
            return
        if let document = self.active:
            let language = "Luce Base" if document.path.ends_with(".lucb") else ("Luce" if document.path.ends_with(".luc") else ("TOML" if document.path.ends_with(".toml") else "Text"))
            let text = f"{language}  |  Ln {document.editor.line()}, Col {document.editor.column()}  |  UTF-8  |  {self.runner.status}"
            if text != self.status_text:
                self.status.set_text(text)
                self.status_text = text

    pub func close(self):
        self.runner.close()
        for connection in self.connections:
            connection.disconnect()
        self.connections.clear()
