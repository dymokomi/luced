## A tolerant source lexer for coloring incomplete Luce and Luce Base documents.
## Offsets count Unicode scalars, exactly as TextEditor does. Parsing and diagnostics
## remain the compiler's responsibility; an unfinished token still gets a color.
pub class Token:
    pub let start: int
    pub let end: int
    pub let kind: str
    pub func init(self, start: int, end: int, kind: str):
        self.start = start
        self.end = end
        self.kind = kind

pub class LineTokens:
    pub let tokens: list[Token]
    pub let state: str
    pub func init(self, tokens: list[Token], state: str):
        self.tokens = tokens
        self.state = state

let keywords = "and as break catch class const continue defer elif else enum errdefer extern false for from func if import in init interface is let match mutating new none not or pub recover return self spawn static struct test true try type var wait while with alloc free"
let types = "int float bool str bytes unit never list map set Error ErrorCode Weak task char i8 i16 i32 i64 u8 u16 u32 u64 usize isize f32 f64 void"

## State contains only an unfinished triple-quoted string delimiter and raw flag.
## Token colors belong to the application theme, never to this lexer.
pub func tokenize(source: str, incoming: str = "") -> LineTokens:
    var state = incoming
    # Materialize once: repeated indexed reads from a UTF-8 string would rescan it.
    var characters: list[str] = []
    for character in source:
        characters.append(character)
    var spans: list[Token] = []
    var index = 0
    while index < characters.length:
        let start = index
        let character = characters[index]
        if state != "" or character == "\"" or character == "'" or (character in ["r", "b", "f"] and index + 1 < characters.length and characters[index + 1] == "\""):
            var raw = state.starts_with("r") if state != "" else character == "r"
            var quote = state[1..<2] if state != "" else character
            var triple = state != ""
            if state == "":
                if character in ["r", "b", "f"]:
                    index += 1
                quote = characters[index]
                triple = index + 2 < characters.length and characters[index + 1] == quote and characters[index + 2] == quote
                index += 3 if triple else 1
            state = ("r" if raw else "s") + quote if triple else ""
            while index < characters.length:
                if not raw and characters[index] == "\\":
                    index += 2 if index + 1 < characters.length else 1
                elif characters[index] == quote:
                    if not triple:
                        index += 1
                        break
                    if index + 2 < characters.length and characters[index + 1] == quote and characters[index + 2] == quote:
                        index += 3
                        state = ""
                        break
                    index += 1
                elif not triple and characters[index] == "\n":
                    break
                else:
                    index += 1
            spans.append(Token(start, index, "string"))
        elif character == "#":
            while index < characters.length and characters[index] != "\n":
                index += 1
            spans.append(Token(start, index, "comment"))
        elif digit(character):
            index += 1
            while index < characters.length:
                let next = characters[index]
                if digit(next) or next in ["_", "x", "X", "o", "O", "b", "B", "a", "c", "d", "e", "f", "A", "C", "D", "E", "F"]:
                    index += 1
                elif next == "." and index + 1 < characters.length and digit(characters[index + 1]):
                    index += 1
                elif next in ["+", "-"] and index > start and characters[index - 1] in ["e", "E"]:
                    index += 1
                else:
                    break
            spans.append(Token(start, index, "number"))
        elif identifier(character):
            var word = character
            index += 1
            while index < characters.length and (identifier(characters[index]) or digit(characters[index])):
                word += characters[index]
                index += 1
            if (" " + keywords + " ").contains(" " + word + " "):
                spans.append(Token(start, index, "keyword"))
            elif (" " + types + " ").contains(" " + word + " ") or (character >= "A" and character <= "Z"):
                spans.append(Token(start, index, "type"))
            else:
                var following = index
                while following < characters.length and characters[following] in [" ", "\t"]:
                    following += 1
                if following < characters.length and characters[following] == "(":
                    spans.append(Token(start, index, "call"))
        else:
            index += 1
    return LineTokens(spans, state)

func digit(character: str) -> bool:
    return character >= "0" and character <= "9"

func identifier(character: str) -> bool:
    return (character >= "a" and character <= "z") or (character >= "A" and character <= "Z") or character == "_" or character > "~"
