## A set of TextMate grammars loaded from a directory, indexed by the file extensions they claim.
## A missing directory or an unreadable or malformed grammar is skipped, so highlighting simply
## falls back rather than failing to open the editor.
from tm_grammar import Grammar, load
from tm_json import parse
from files import Entries
import files
import os
import workspace.paths as paths

## A lazily-loaded set of TextMate grammars. Loading and compiling a grammar is costly, so at
## startup only a small `index.json` manifest (extension -> file, scope -> file) is read; a
## grammar's file is parsed and its patterns compiled the first time a document of that type is
## opened, then cached. This keeps launch instant however many grammars are bundled.
pub class GrammarSet:
    var dir: str
    var ext_to_file: map[str, str]
    var scope_to_file: map[str, str]
    var cache: map[str, Grammar]

    pub func init(self, directory: str) -> unit:
        self.dir = directory
        self.ext_to_file = {}
        self.scope_to_file = {}
        self.cache = {}
        let text = files.read_text(paths.join(directory, "index.json"), 4000000) catch failure:
            return
        let doc = parse(text) catch failure:
            return
        if let exts = doc.get("extensions"):
            for ext in exts.keys():
                if let file = exts.get(ext):
                    self.ext_to_file[ext] = file.as_str()
        if let scopes = doc.get("scopes"):
            for scope in scopes.keys():
                if let file = scopes.get(scope):
                    self.scope_to_file[scope] = file.as_str()

    ## Load and cache the grammar in `filename`, or none if it is missing or malformed.
    func load_file(self, filename: str) -> Grammar?:
        if let cached = self.cache[filename]:
            return cached
        let text = files.read_text(paths.join(self.dir, filename), 4000000) catch failure:
            return none
        let grammar = load(text) catch failure:
            return none
        self.cache[filename] = grammar
        return grammar

    ## The grammar for a file path's extension (compiled on first use), or none.
    pub func grammar_for(self, path: str) -> Grammar?:
        let ext = extension_of(path)
        if ext == "":
            return none
        let filename = self.ext_to_file[ext] else return none
        return self.load_file(filename)

    ## The registry the tokenizer uses to resolve embedded-language includes. Empty for now:
    ## resolving `source.x` lazily without eagerly compiling every grammar needs a lazy resolver
    ## the tokenizer does not have yet, so embedded sub-languages are left to a later pass.
    pub func scope_map(self) -> map[str, Grammar]:
        return {}

    pub func count(self) -> int:
        return self.ext_to_file.length

## Copy any grammar bundled beside the binary into `config_grammars` (create-only), so a
## from-source or installed build offers all its grammars without embedding them all. The bundle
## sits near the executable; a few conventional locations are tried and the first with grammars
## wins. Existing files in the config directory are kept.
pub func install_bundled(config_grammars: str) -> unit:
    let exe = os.executable() catch failure:
        return
    let exe_dir = paths.parent(exe)
    let parent = paths.parent(exe_dir)
    let candidates = [paths.join(exe_dir, "grammars"), paths.join(parent, "grammars"), paths.join(parent, "share/luced/grammars")]
    for candidate in candidates:
        if copy_grammars(candidate, config_grammars):
            return

func copy_grammars(source: str, target: str) -> bool:
    let snapshot = Entries(source) catch failure:
        return false
    var found = false
    for index in 0..<snapshot.count():
        let name = snapshot.name(index) catch failure: continue
        if not name.ends_with(".json"):
            continue
        found = true
        let text = files.read_text(paths.join(source, name), 4000000) catch failure: continue
        files.create_text(paths.join(target, name), text) catch failure: continue
    snapshot.close()
    return found

## The extension of a path without its dot ("src/main.rs" -> "rs"), or "" when it has none.
func extension_of(path: str) -> str:
    let base = path.replace("\\", "/").split("/").last else path
    let parts = base.split(".")
    if parts.length < 2:
        return ""
    return parts.last else ""
