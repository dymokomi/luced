## Structure is derived from lexer output, not raw colon or quote searches.
## Cached line metadata is shared with highlighting; only edited lines are read
## again. The linear scope pass visits metadata and never retokenizes the file.
from ui import FoldRange
from language.syntax import LineTokens

pub class Line:
    pub let start: int
    pub let end: int
    pub let state: str
    pub let indent: int
    pub let significant: bool
    pub let opens: bool
    pub let nonempty: bool
    pub let in_string: bool

    pub func init(self, start: int, end: int, state: str, indent: int,
                  significant: bool, opens: bool, nonempty: bool, in_string: bool):
        self.start = start
        self.end = end
        self.state = state
        self.indent = indent
        self.significant = significant
        self.opens = opens
        self.nonempty = nonempty
        self.in_string = in_string

    pub func shifted(self, delta: int) -> Line:
        return Line(self.start + delta, self.end + delta, self.state, self.indent,
            self.significant, self.opens, self.nonempty, self.in_string)

pub func analyze(text: str, start: int, end: int, incoming: str, parsed: LineTokens) -> Line:
    var indent = 0
    var leading = true
    var nonempty = false
    var last = ""
    var offset = 0
    var token = 0
    for character in text:
        if leading:
            if character == " ":
                indent += 1
            elif character == "\t":
                indent += 4 - indent % 4
            else:
                leading = false
        if not (character in [" ", "\t", "\n"]):
            nonempty = true
        while token < parsed.tokens.length and parsed.tokens[token].end <= offset:
            token += 1
        let masked = token < parsed.tokens.length and parsed.tokens[token].start <= offset and parsed.tokens[token].kind in ["string", "comment"]
        if not masked and not (character in [" ", "\t", "\n"]):
            last = character
        offset += 1
    return Line(start, end, parsed.state, indent, last != "", last == ":", nonempty, incoming != "")

pub func ranges(lines: list[Line], length: int) -> list[FoldRange]:
    var ends: list[int] = []
    var bodies: list[bool] = []
    for line in lines:
        ends.append(0)
        bodies.append(false)
    var stack: list[int] = []
    var depth = 0
    var string_header = -1
    for index in 0..<lines.length:
        let line = lines[index]
        if line.significant and not line.in_string:
            while depth > 0 and lines[stack[depth - 1]].indent >= line.indent:
                depth -= 1
                let header = stack[depth]
                if bodies[header]:
                    ends[header] = line.start
        if depth > 0 and line.nonempty and line.indent > lines[stack[depth - 1]].indent:
            bodies[stack[depth - 1]] = true
        if line.opens and not line.in_string:
            if depth == stack.length:
                stack.append(index)
            else:
                stack[depth] = index
            depth += 1
        if not line.in_string and line.state != "":
            string_header = index
        elif line.in_string and line.state == "" and string_header >= 0:
            ends[string_header] = line.end
            string_header = -1
    while depth > 0:
        depth -= 1
        let header = stack[depth]
        if bodies[header]:
            ends[header] = length
    if string_header >= 0:
        ends[string_header] = length
    var folds: list[FoldRange] = []
    for index in 0..<lines.length:
        let line = lines[index]
        if ends[index] > line.end:
            folds.append(FoldRange(line.start, ends[index]))
    return folds
