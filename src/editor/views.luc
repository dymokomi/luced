## Named view components expose only the controls that the workspace updates.
## Geometry uses font cells and text lines; continuous GPU content still fills
## the remaining area. Menus and toolbars share the same native actions.
from ui import Font, Text, TextEditor, ListView, VStack, Toolbar, Menu, Button, Spacer, Size, Pane, PaneHeader, IconKind, SplitView, Axis, ContextMenu, CommandPalette, TextPrompt
from editor.actions import EditorActions
from workspace.explorer import Explorer
import workspace.paths as paths
import editor.file_items as file_items

pub class Sidebar:
    pub let directory: PaneHeader
    pub let listing: ListView
    pub let body: Pane
    pub let context: ContextMenu

    pub func init(self, explorer: Explorer, actions: EditorActions, font: Font) -> unit!:
        let directory = PaneHeader("FILES", icon = IconKind.folder_open, detail = paths.name(explorer.directory), font = font)
        let listing = ListView(file_items.present(explorer.entries), font = font)
        let context = ContextMenu(listing, actions.files.all, font = font)
        self.context = context
        self.directory = directory
        self.listing = listing
        self.body = Pane(context, header = directory, minimum = Size(140.0, 100.0))

pub class EditorPane:
    pub let title: PaneHeader
    pub let host: VStack
    pub let body: Pane
    pub let context: ContextMenu

    pub func init(self, actions: EditorActions, font: Font) -> unit!:
        let title = PaneHeader("EDITOR", icon = IconKind.code, font = font)
        let welcome = TextEditor("luced\n\nChoose a file from the explorer to begin.\n\nCmd/Ctrl+S        Save\nCmd/Ctrl+Shift+S  Save all\nCmd/Ctrl+B        Build\nF5               Build and run\nShift+F5         Stop\nCtrl+Tab         Move between controls\n", read_only = true, line_numbers = false, font = font)
        let host = VStack([welcome], spacing = 0.0)
        host.layout().set_flex()
        let context = ContextMenu(host, actions.editing.all + [actions.save, actions.fold, actions.fold_all, actions.unfold_all], font = font)
        self.context = context
        self.title = title
        self.host = host
        self.body = Pane(context, header = title, minimum = Size(240.0, 100.0))

pub class OutputPane:
    pub let output: TextEditor
    pub let body: Pane
    pub let context: ContextMenu

    pub func init(self, actions: EditorActions, font: Font) -> unit!:
        let output = TextEditor("Compiler and program output will appear here.\n", read_only = true, line_numbers = false, font = font)
        actions.output.bind(output)
        let context = ContextMenu(output, actions.output.all, font = font)
        let title = PaneHeader("OUTPUT", icon = IconKind.terminal, font = font)
        self.context = context
        self.output = output
        self.body = Pane(context, header = title, minimum = Size(240.0, 80.0))

pub class EditorView:
    pub let sidebar: Sidebar
    pub let editor: EditorPane
    pub let output: OutputPane
    pub let status: Text
    pub let palette: CommandPalette
    pub let prompt: TextPrompt
    pub let menu: Toolbar
    pub let body: ContextMenu

    pub func init(self, explorer: Explorer, actions: EditorActions, font: Font) -> unit!:
        let sidebar = Sidebar(explorer, actions, font)
        let editor = EditorPane(actions, font)
        let output = OutputPane(actions, font)
        let status = Text("Ready", font = font)
        let menu = Toolbar([
            Menu("File", [actions.files.new_file, actions.files.new_folder, actions.save, actions.save_all, actions.settings, actions.theme, actions.discard_changes], font = font),
            Menu("Edit", actions.editing.all, font = font),
            Menu("Build", [actions.build, actions.run, actions.stop], font = font),
            Menu("View", [actions.palette, actions.fold, actions.fold_all, actions.unfold_all, actions.next_pane, actions.previous_pane, actions.reload], font = font),
            Spacer(),
            Button(action = actions.save, font = font),
            Button(action = actions.build, font = font),
            Button(action = actions.run, font = font),
            Button(action = actions.stop, font = font)
        ], font = font)
        self.menu = menu
        let center = SplitView(editor.body, output.body, axis = Axis.vertical, fraction = 0.77)
        let panes = SplitView(sidebar.body, center, fraction = 0.22)
        let palette = CommandPalette(actions.all, font = font)
        let prompt = TextPrompt(font = font)
        self.palette = palette
        self.prompt = prompt
        self.sidebar = sidebar
        self.editor = editor
        self.output = output
        self.status = status
        let content = VStack([menu, panes, Toolbar([status], font = font), palette, prompt], spacing = 0.0)
        self.body = ContextMenu(content, [actions.palette, actions.settings, actions.theme, actions.reload, actions.next_pane], font = font)
