## One action instance supplies each command everywhere it is presented.
from ui import Action, Shortcut
from input import Key
from interop import Connection
from workspace.controller import Workspace
from editor.text_actions import TextActions
from editor.file_actions import FileActions

pub class EditorActions:
    pub let save: Action
    pub let save_all: Action
    pub let build: Action
    pub let run: Action
    pub let stop: Action
    pub let discard_changes: Action
    pub let fold: Action
    pub let fold_all: Action
    pub let unfold_all: Action
    pub let palette: Action
    pub let settings: Action
    pub let theme: Action
    pub let reload: Action
    pub let next_pane: Action
    pub let previous_pane: Action
    pub let focus_explorer: Action
    pub let focus_editor: Action
    pub let focus_output: Action
    pub let editing: TextActions
    pub let output: TextActions
    pub let files: FileActions
    pub let all: list[Action]

    pub func init(self) -> unit!:
        let save = Action("Save", Shortcut(Key.s, primary = true))
        let save_all = Action("Save all", Shortcut(Key.s, primary = true, shift = true))
        let build = Action("Build", Shortcut(Key.b, primary = true))
        let run = Action("Run", Shortcut(Key.f5))
        let stop = Action("Stop", Shortcut(Key.f5, shift = true))
        let discard_changes = Action("Discard & close")
        self.save = save
        self.save_all = save_all
        self.build = build
        self.run = run
        self.stop = stop
        self.discard_changes = discard_changes
        let fold = Action("Toggle fold", Shortcut(Key.left_bracket, primary = true, alt = true))
        let fold_all = Action("Fold all", Shortcut(Key.left_bracket, primary = true, shift = true, alt = true))
        let unfold_all = Action("Unfold all", Shortcut(Key.right_bracket, primary = true, shift = true, alt = true))
        self.fold = fold
        self.fold_all = fold_all
        self.unfold_all = unfold_all
        let palette = Action("Command Palette", Shortcut(Key.p, primary = true))
        self.palette = palette
        let settings = Action("Edit Settings")
        self.settings = settings
        let theme = Action("Edit Theme")
        self.theme = theme
        let reload = Action("Reload Configuration")
        self.reload = reload
        let next_pane = Action("Next Panel", Shortcut(Key.f6))
        self.next_pane = next_pane
        let previous_pane = Action("Previous Panel", Shortcut(Key.f6, shift = true))
        self.previous_pane = previous_pane
        let focus_explorer = Action("Focus Explorer", Shortcut(Key.digit_1, primary = true))
        self.focus_explorer = focus_explorer
        let focus_editor = Action("Focus Editor", Shortcut(Key.digit_2, primary = true))
        self.focus_editor = focus_editor
        let focus_output = Action("Focus Output", Shortcut(Key.digit_3, primary = true))
        self.focus_output = focus_output
        let editing = TextActions()
        let output = TextActions(output = true)
        let files = FileActions()
        self.editing = editing
        self.output = output
        self.files = files
        self.all = [save, save_all, build, run, stop, discard_changes, fold, fold_all, unfold_all, palette, settings, theme, reload, next_pane, previous_pane, focus_explorer, focus_editor, focus_output] + files.all + editing.all + output.all


    pub func connect(self, workspace: Workspace) -> list[Connection]!:
        return [self.save.on_trigger(workspace.save), self.save_all.on_trigger(workspace.save_all),
            self.build.on_trigger(workspace.build), self.run.on_trigger(workspace.run),
            self.stop.on_trigger(workspace.stop), self.discard_changes.on_trigger(workspace.discard_and_close),
            self.fold.on_trigger(workspace.toggle_fold), self.fold_all.on_trigger(workspace.fold_all),
            self.unfold_all.on_trigger(workspace.unfold_all)]

    pub func update(self, workspace: Workspace, busy: bool):
        self.editing.bind(workspace.current_editor())
        self.output.update()
        self.files.update()
        self.save.set_enabled(workspace.has_document())
        self.save_all.set_enabled(workspace.has_document())
        self.build.set_enabled(workspace.has_document() and not busy)
        self.run.set_enabled(workspace.has_document() and not busy)
        self.stop.set_enabled(busy)
        self.fold.set_enabled(workspace.has_document())
        self.fold_all.set_enabled(workspace.has_document())
        self.unfold_all.set_enabled(workspace.has_document())
