## One action instance supplies each command everywhere it is presented.
from ui import Command, Shortcut
from input import Key
from interop import Connection
from workspace.controller import Workspace
from editor.text_actions import TextActions
from editor.file_actions import FileActions

pub class EditorActions:
    pub let new_tab: Command
    pub let save: Command
    pub let save_all: Command
    pub let build: Command
    pub let run: Command
    pub let stop: Command
    pub let discard_changes: Command
    pub let fold: Command
    pub let fold_all: Command
    pub let unfold_all: Command
    pub let word_wrap: Command
    pub let palette: Command
    pub let settings: Command
    pub let theme: Command
    pub let ai_settings: Command
    pub let reload: Command
    pub let next_pane: Command
    pub let previous_pane: Command
    pub let focus_explorer: Command
    pub let focus_editor: Command
    pub let focus_output: Command
    pub let focus_left: Command
    pub let focus_right: Command
    pub let focus_up: Command
    pub let focus_down: Command
    pub let editing: TextActions
    pub let output: TextActions
    pub let files: FileActions
    pub let all: list[Command]

    pub func init(self) -> unit!:
        let new_tab = Command("New Tab", Shortcut(Key.n, primary = true), id = "new_tab")
        self.new_tab = new_tab
        let save = Command("Save", Shortcut(Key.s, primary = true), id = "save")
        let save_all = Command("Save all", Shortcut(Key.s, primary = true, shift = true), id = "save_all")
        let build = Command("Build", Shortcut(Key.b, primary = true), id = "build")
        let run = Command("Run", Shortcut(Key.f5), id = "run")
        let stop = Command("Stop", Shortcut(Key.f5, shift = true), id = "stop")
        let discard_changes = Command("Discard & close", id = "discard")
        self.save = save
        self.save_all = save_all
        self.build = build
        self.run = run
        self.stop = stop
        self.discard_changes = discard_changes
        let fold = Command("Toggle fold", Shortcut(Key.left_bracket, primary = true, alt = true), id = "fold")
        let fold_all = Command("Fold all", Shortcut(Key.left_bracket, primary = true, shift = true, alt = true), id = "fold_all")
        let unfold_all = Command("Unfold all", Shortcut(Key.right_bracket, primary = true, shift = true, alt = true), id = "unfold_all")
        self.fold = fold
        self.fold_all = fold_all
        self.unfold_all = unfold_all
        let word_wrap = Command("Toggle Word Wrap", Shortcut(Key.z, primary = true, alt = true), id = "toggle_word_wrap")
        self.word_wrap = word_wrap
        let palette = Command("Command Palette", Shortcut(Key.p, primary = true), id = "command_palette")
        self.palette = palette
        let settings = Command("Edit Settings", id = "edit_settings")
        self.settings = settings
        let theme = Command("Edit Theme", id = "edit_theme")
        self.theme = theme
        let ai_settings = Command("Edit AI Settings", id = "edit_ai_settings")
        self.ai_settings = ai_settings
        let reload = Command("Reload Configuration", id = "reload_config")
        self.reload = reload
        let next_pane = Command("Next Panel", Shortcut(Key.f6), id = "next_pane")
        self.next_pane = next_pane
        let previous_pane = Command("Previous Panel", Shortcut(Key.f6, shift = true), id = "previous_pane")
        self.previous_pane = previous_pane
        let focus_explorer = Command("Focus Explorer", Shortcut(Key.digit_1, primary = true), id = "focus_explorer")
        self.focus_explorer = focus_explorer
        let focus_editor = Command("Focus Editor", Shortcut(Key.digit_2, primary = true), id = "focus_editor")
        self.focus_editor = focus_editor
        let focus_output = Command("Focus Output", Shortcut(Key.digit_3, primary = true), id = "focus_output")
        self.focus_output = focus_output
        let focus_left = Command("Focus Pane Left", Shortcut(Key.left, primary = true, alt = true), id = "focus_left")
        self.focus_left = focus_left
        let focus_right = Command("Focus Pane Right", Shortcut(Key.right, primary = true, alt = true), id = "focus_right")
        self.focus_right = focus_right
        let focus_up = Command("Focus Pane Up", Shortcut(Key.up, primary = true, alt = true), id = "focus_up")
        self.focus_up = focus_up
        let focus_down = Command("Focus Pane Down", Shortcut(Key.down, primary = true, alt = true), id = "focus_down")
        self.focus_down = focus_down
        let editing = TextActions()
        let output = TextActions(output = true)
        let files = FileActions()
        self.editing = editing
        self.output = output
        self.files = files
        self.all = [new_tab, save, save_all, build, run, stop, discard_changes, fold, fold_all, unfold_all, word_wrap, palette, settings, theme, ai_settings, reload, next_pane, previous_pane, focus_explorer, focus_editor, focus_output, focus_left, focus_right, focus_up, focus_down] + files.all + editing.all + output.all


    pub func connect(self, workspace: Workspace) -> list[Connection]!:
        return [self.new_tab.on_trigger(workspace.new_tab), self.save.on_trigger(self.files.save_document), self.save_all.on_trigger(workspace.save_all),
            self.build.on_trigger(workspace.build), self.run.on_trigger(workspace.run),
            self.stop.on_trigger(workspace.stop), self.discard_changes.on_trigger(workspace.discard_and_close),
            self.fold.on_trigger(workspace.toggle_fold), self.fold_all.on_trigger(workspace.fold_all),
            self.unfold_all.on_trigger(workspace.unfold_all), self.word_wrap.on_trigger(workspace.toggle_word_wrap)]

    pub func update(self, workspace: Workspace, busy: bool):
        self.editing.bind(workspace.current_editor())
        self.output.update()
        self.files.update()
        self.save.set_enabled(workspace.has_document())
        self.save_all.set_enabled(workspace.has_document())
        self.build.set_enabled(workspace.has_document() and not busy)
        self.run.set_enabled(workspace.has_document() and not busy)
        self.stop.set_enabled(busy)
        self.fold.set_enabled(workspace.has_document())
        self.fold_all.set_enabled(workspace.has_document())
        self.unfold_all.set_enabled(workspace.has_document())
