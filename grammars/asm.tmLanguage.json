{
  "name": "Assembly",
  "scopeName": "source.asm",
  "fileTypes": ["s", "S", "asm", "nasm", "inc"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#label" },
    { "include": "#directive" },
    { "include": "#number" },
    { "include": "#register" },
    { "include": "#mnemonic" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        { "match": ";.*$", "name": "comment.line.semicolon.asm" },
        { "match": "//.*$", "name": "comment.line.double-slash.asm" },
        { "match": "@.*$", "name": "comment.line.at-sign.asm" },
        { "match": "#(?![0-9$+-]).*$", "name": "comment.line.number-sign.asm" },
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block.asm" }
      ]
    },
    "string": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.asm",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.asm" }]
        },
        { "match": "'(\\\\.|[^'])'", "name": "string.quoted.single.asm" }
      ]
    },
    "label": {
      "match": "^\\s*([.A-Za-z_$][\\w.$]*)\\s*:",
      "captures": { "1": { "name": "entity.name.function.label.asm" } }
    },
    "directive": {
      "match": "(?<![\\w.])\\.[A-Za-z_][A-Za-z0-9_.]*",
      "name": "keyword.control.directive.asm"
    },
    "number": {
      "patterns": [
        { "match": "#-?(?:0[xX][0-9a-fA-F]+|[0-9]+)\\b", "name": "constant.numeric.immediate.asm" },
        { "match": "\\$?-?\\b0[xX][0-9a-fA-F]+\\b", "name": "constant.numeric.hex.asm" },
        { "match": "\\$?-?\\b0[bB][01]+\\b", "name": "constant.numeric.binary.asm" },
        { "match": "\\$?-?\\b[0-9]+(?:\\.[0-9]+)?\\b", "name": "constant.numeric.asm" }
      ]
    },
    "register": {
      "patterns": [
        { "match": "%[A-Za-z][A-Za-z0-9]*", "name": "variable.language.register.asm" },
        { "match": "\\b(?:[xw](?:[12]?[0-9]|3[01])|sp|wsp|lr|pc|fp|ip|xzr|wzr)\\b", "name": "variable.language.register.asm" },
        { "match": "\\b(?:r(?:1[0-5]|[0-9])|[re]?(?:ax|bx|cx|dx|si|di|sp|bp)|[abcd][hl]|sil|dil|spl|bpl|r(?:8|9|1[0-5])[dwb]?)\\b", "name": "variable.language.register.asm" }
      ]
    },
    "mnemonic": {
      "match": "(?i)(?<![\\w.])(?:mov[abwlq]?|movz[bwlq]{2}|movs[bwlq]{2}|lea[lq]?|push[lq]?|pop[lq]?|add[bwlq]?|sub[bwlq]?|adc|sbb|i?mul[bwlq]?|i?div[bwlq]?|inc[bwlq]?|dec[bwlq]?|neg|and[bwlq]?|x?or[bwlq]?|not|shl|shr|sar|sal|rol|ror|cmp[bwlq]?|test[bwlq]?|set[a-z]{1,2}|cmov[a-z]{1,2}|call[q]?|ret[q]?|leave|enter|jmp[q]?|j[a-z]{1,3}|loop|nop|hlt|int|into|iret[dq]?|syscall|sysret|cpuid|rdtsc|cdq[e]?|cqo|cbw|cwde|cwd|cld|std|cli|sti|cvt[a-z0-9]{2,}|u?comis[sd]|mov[su][sd]|add[sp][sd]|sub[sp][sd]|mul[sp][sd]|div[sp][sd]|sqrt[sp][sd]|xorp[sd]|movap[sd]|movdq[au]|p[a-z]+|ldr[bhsw]?|str[bhsw]?|ldp|stp|ldur|stur|mov[nkz]?|adr[p]?|b|bl|blr|br|cbz|cbnz|tbz|tbnz|adds?|subs?|muls?|madd|msub|mneg|smull|umull|sdiv|udiv|orr|eor|and|bic|orn|eon|lsl|lsr|asr|rorv?|tst|cmn|cmp|ccmp|csel|cset|csetm|csinc|csinv|csneg|bfi|bfxil|[su]bfx|[su]bfiz|ubfm|sbfm|extr|rev[1-9]*|clz|rbit|fmov|fadd|fsub|fmul|fdiv|fsqrt|fneg|fabs|fcmp|fcvt[a-z]*|scvtf|ucvtf|frintz?|dmb|dsb|isb|svc|hvc|smc|brk|wfe|wfi|yield|sev|nop)(?![\\w.])",
      "name": "keyword.mnemonic.asm"
    }
  }
}
