from ui import TextEditor
from workspace.document import Document
from editor.application import Editor
from editor.options import Options
import language.syntax as syntax
from language.highlighter import Highlighter
from gpu import Color
from ui import Highlight
import ui
import workspace.paths as paths
import files
import thread
from configuration_tests import configuration
from workspace_tab_tests import workspace_tabs

pub func main(arguments: list[str]) -> int!:
    language_folding()
    highlighting()
    randomized_highlighting()
    let root = arguments[0]
    configuration(root, arguments[1], arguments[2])
    workspace_tabs(root, arguments[1], arguments[2])
    let source = paths.join(root, "main.luc")
    let original = "pub func main(arguments: list[str]) -> int!:\r\n    print(\"hello from luced\")\r\n    return 0\r\n"
    files.write_text(source, original)
    let document = Document(source)
    assert(not document.dirty())
    assert(document.editor.set_folded(1, true) and not document.dirty())
    document.editor.unfold_all()
    document.editor.set_selection(0, 0)
    document.editor.insert("# edited\n")
    assert(document.dirty())
    document.save()
    assert(files.read_text(source).starts_with("# edited\r\n"))
    assert(not document.dirty())
    document.editor.undo()
    assert(document.dirty())
    document.save()
    assert(files.read_text(source) == original)
    files.write_text(source, "changed externally")
    document.editor.insert("# conflict\n")
    var refused = false
    document.save() catch failure:
        refused = true
    assert(refused and files.read_text(source) == "changed externally")
    files.write_text(source, original)
    let mixed_path = paths.join(root, "mixed.txt")
    files.write_text(mixed_path, "one\r\ntwo\n")
    let mixed = Document(mixed_path)
    assert(not mixed.dirty())
    mixed.save()
    assert(files.read_text(mixed_path) == "one\r\ntwo\n")
    let spans = syntax.tokenize("# λ\nlet text = \"é😀\"\nlet number = 0xff\n").tokens
    assert(spans.length == 5)
    assert(spans[0].start == 0 and spans[0].end == 3)
    assert(spans[1].start == 4 and spans[1].end == 7)
    assert(spans[2].start == 15 and spans[2].end == 19)
    let instance = Editor(Options([source, "--config-dir", paths.join(root, "session"), "--luce", arguments[1], "--base", arguments[2]]))
    let app = instance.app
    let workspace = instance.workspace
    let runner = instance.runner
    let output = instance.view.output.output
    workspace.frame(0.2)
    assert(workspace.can_close())
    let editor = workspace.current_editor() else error(ui.invalid, "source was not opened")
    app.layout(800.0, 600.0)
    assert(editor.layout().is_focused())
    runner.build(source, true)
    var iterations = 0
    while runner.busy():
        runner.poll()
        thread.yield()
        iterations += 1
        assert(iterations < 10000000)
    assert(output.text().contains("hello from luced") and output.text().ends_with("[Exit 0]\n"))
    let base_source = paths.join(root, "main.lucb")
    files.write_text(base_source, "import io\n\npub func main(arguments: str[]) -> i32!:\n    var output = io.stdout()\n    discard(try output.write(\"hello from base\\n\".bytes))\n    return 0\n")
    runner.build(base_source, true)
    iterations = 0
    while runner.busy():
        runner.poll()
        thread.yield()
        iterations += 1
        assert(iterations < 10000000)
    assert(output.text().contains("hello from base") and output.text().ends_with("[Exit 0]\n"))
    instance.close()
    assert(paths.parent("C:/work") == "C:/")
    assert(paths.parent("/work") == "/")
    print("PASS luced source highlighting, document persistence, conflicts, workspace and native build/run")
    return 0

func highlighting() -> unit!:
    var text = ""
    for index in 0..<1000:
        text += "let value = 123 # λ\n"
    let editor = TextEditor(text)
    let service = Highlighter(editor)
    service.update()
    assert(service.scanned_lines == 1000)
    let connection = editor.on_change(service.update)
    editor.set_selection(12, 15)
    editor.insert("4567")
    assert(service.scanned_lines == 1)
    assert(editor.highlight_at(0) != none and editor.highlight_at(21) != none)
    let revision = editor.version()
    editor.undo()
    assert(service.scanned_lines == 1 and editor.text() == text)
    assert(not editor.update_highlights(0, 3, [Highlight(0, 3, Color())], revision))
    editor.redo()
    assert(service.scanned_lines == 1)
    editor.set_selection(0, 0)
    editor.insert("# 😀\n# é\n")
    assert(service.scanned_lines <= 3)
    editor.set_selection(0, 8)
    editor.insert("")
    compare_highlighting(editor)
    editor.set_text("let a = \"\"\"open\nlet inside = 1\nend\"\"\"\nlet outside = 2\n")
    assert(service.scanned_lines == 4)
    editor.set_selection(8, 11)
    editor.insert("")
    assert(service.scanned_lines == 4)
    compare_highlighting(editor)
    editor.undo()
    compare_highlighting(editor)
    editor.set_selection(editor.length(), editor.length())
    editor.insert("let tail = 4")
    compare_highlighting(editor)
    connection.disconnect()

func compare_highlighting(editor: TextEditor) -> unit!:
    let fresh = TextEditor(editor.text())
    assert(editor.visible_line_count() == fresh.visible_line_count())
    let highlighter = Highlighter(fresh)
    highlighter.update()
    for offset in 0..<editor.length():
        let current = editor.highlight_at(offset)
        let expected = fresh.highlight_at(offset)
        assert((current == none) == (expected == none))
        if let actual = current:
            let wanted = expected else error(ui.invalid, "missing expected highlight")
            assert(actual.red == wanted.red and actual.green == wanted.green and actual.blue == wanted.blue)

func randomized_highlighting() -> unit!:
    let editor = TextEditor("let text = r\"\"\"raw\nλ\nend\"\"\"\nprint(text)\n")
    let service = Highlighter(editor)
    service.update()
    let connection = editor.on_change(service.update)
    let insertions = ["", "#", "\n", "\"", "\"\"\"", "\\", "é😀", "r\"", "let x = 0xff\n", "'a'"]
    var seed = 17
    for iteration in 0..<200:
        seed = (seed * 48271) % 2147483647
        let start = seed % (editor.length() + 1)
        seed = (seed * 48271) % 2147483647
        let count = seed % 5
        let end = start + count if start + count < editor.length() else editor.length()
        editor.set_selection(start, end)
        editor.insert(insertions[seed % insertions.length])
        compare_highlighting(editor)
        if iteration % 7 == 0:
            editor.undo()
            compare_highlighting(editor)
            editor.redo()
            compare_highlighting(editor)
    connection.disconnect()
    # A consumer may publish later or fail. Unaffected ranges remain colored in
    # their new positions even when no highlighter is connected to the widget.
    editor.set_text("let x = 1\nlet y = 2")
    editor.set_highlights([Highlight(10, 13, Color(0.3, 0.5, 0.7))])
    editor.set_selection(0, 0)
    editor.insert("# 😀\n")
    assert(editor.highlight_at(14) != none and editor.highlight_at(10) == none)
    let version = editor.version()
    editor.insert("")
    assert(editor.version() == version)

func language_folding() -> unit!:
    let source = "pub func outer():\n    if true:\n        print(\"a: # text\")\n    # retained comment\n    print(\"done\")\n\nlet tail = 1\n"
    let editor = TextEditor(source)
    let service = Highlighter(editor)
    service.update()
    let connection = editor.on_change(service.update)
    let rows = editor.visible_line_count()
    assert(editor.set_folded(2, true))
    assert(editor.set_folded(1, true))
    assert(editor.visible_line_count() < rows and editor.text() == source)
    editor.set_selection(editor.length(), editor.length())
    editor.insert("# unrelated\n")
    assert(editor.is_folded(1) and editor.is_folded(2))
    assert(service.scanned_lines == 1)
    assert(editor.set_folded(1, false) and editor.is_folded(2))
    editor.set_selection(0, 0)
    editor.insert("# 😀 before\n")
    assert(editor.is_folded(3))
    editor.undo()
    assert(editor.is_folded(2))
    editor.set_text("let text = r\"\"\"first\nif false:\n    literal\nend\"\"\"\nlet next = 0\n")
    assert(editor.set_folded(1, true))
    assert(not editor.set_folded(2, true))
    assert(editor.visible_line_count() == 3)
    editor.unfold_all()
    assert(editor.visible_line_count() == 6)
    editor.set_text("# comment:\n    # continuation\nlet text = \"colon:\"\n    let value = 1\n")
    assert(not editor.set_folded(1, true) and not editor.set_folded(3, true))
    editor.set_text("pub func empty():\n\nlet next = 0\n")
    assert(not editor.set_folded(1, true))
    connection.disconnect()
